const { supabaseAdmin } = require('../supabaseClient');
const { removeFile } = require('../services/storageService');

// ==============================================================================
// CATEGORIES - CONTROLLER CRUD
// ==============================================================================

// Champs autorisés à la création / mise à jour (anti-mass-assignment)
const ALLOWED_FIELDS = ['parent_id', 'name', 'slug', 'description', 'image_url'];

/**
 * Génère un slug unique à partir d'un nom.
 */
async function generateUniqueSlug(baseName, excludeId = null) {
  const base = (baseName || 'categorie')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'categorie';

  let slug = base;
  let suffix = 0;

  while (suffix < 100) {
    let query = supabaseAdmin.from('categories').select('id').eq('slug', slug).is('deleted_at', null);
    if (excludeId) query = query.neq('id', excludeId);
    const { data } = await query;
    if (!data || data.length === 0) return slug;
    suffix += 1;
    slug = `${base}-${suffix}`;
  }
  return `${base}-${Date.now()}`;
}

// --------------------------------------------------------------------
// GET /api/categories
// --------------------------------------------------------------------
exports.getAllCategories = async (req, res) => {
  try {
    const { data, error } = await supabaseAdmin
      .from('categories')
      .select('*')
      .is('deleted_at', null)
      .order('name', { ascending: true });
    if (error) throw error;
    return res.json({ success: true, count: data.length, data });
  } catch (error) {
    return res.status(500).json({ success: false, message: error.message });
  }
};

// --------------------------------------------------------------------
// GET /api/categories/parents — catégories utilisables comme parent
// --------------------------------------------------------------------
exports.getParentCategories = async (req, res) => {
  try {
    const { data, error } = await supabaseAdmin
      .from('categories')
      .select('id, name, slug')
      .is('deleted_at', null)
      .is('parent_id', null)
      .order('name', { ascending: true });
    if (error) throw error;
    return res.json({ success: true, count: data.length, data });
  } catch (error) {
    return res.status(500).json({ success: false, message: error.message });
  }
};

// --------------------------------------------------------------------
// GET /api/categories/:id
// --------------------------------------------------------------------
exports.getCategoryById = async (req, res) => {
  try {
    const { id } = req.params;
    const { data, error } = await supabaseAdmin
      .from('categories')
      .select('*, products (*)')
      .or(`id.eq.${id},slug.eq.${id}`)
      .is('deleted_at', null)
      .single();
    if (error || !data) return res.status(404).json({ success: false, message: 'Catégorie non trouvée' });
    return res.json({ success: true, data });
  } catch (error) {
    return res.status(500).json({ success: false, message: error.message });
  }
};

// --------------------------------------------------------------------
// POST /api/categories
// Body: { name*, description, parent_id, image_url, slug }
// --------------------------------------------------------------------
exports.createCategory = async (req, res) => {
  try {
    const { name, description, parent_id, image_url, slug } = req.body;

    if (!name || typeof name !== 'string' || !name.trim()) {
      return res.status(400).json({ success: false, message: 'Le champ "name" est requis' });
    }

    if (parent_id) {
      const { data: parent, error: parentErr } = await supabaseAdmin
        .from('categories')
        .select('id')
        .eq('id', parent_id)
        .is('deleted_at', null)
        .single();
      if (parentErr || !parent) {
        return res.status(400).json({ success: false, message: 'Catégorie parente introuvable' });
      }
    }

    let finalSlug = (slug || '').trim();
    if (!finalSlug) {
      finalSlug = await generateUniqueSlug(name);
    } else {
      const { data: existing } = await supabaseAdmin
        .from('categories')
        .select('id')
        .eq('slug', finalSlug)
        .is('deleted_at', null);
      if (existing && existing.length > 0) {
        return res.status(409).json({ success: false, message: 'Ce slug est déjà utilisé' });
      }
    }

    const payload = {
      parent_id: parent_id || null,
      name: name.trim(),
      slug: finalSlug,
      description: description || null,
      image_url: image_url || null,
    };

    const { data, error } = await supabaseAdmin
      .from('categories')
      .insert([payload])
      .select()
      .single();

    if (error) throw error;
    return res.status(201).json({ success: true, message: 'Catégorie créée avec succès', data });
  } catch (error) {
    return res.status(500).json({ success: false, message: error.message });
  }
};

// --------------------------------------------------------------------
// PUT /api/categories/:id
// --------------------------------------------------------------------
exports.updateCategory = async (req, res) => {
  try {
    const { id } = req.params;
    const updates = req.body;

    const { data: existing, error: findErr } = await supabaseAdmin
      .from('categories')
      .select('*')
      .eq('id', id)
      .is('deleted_at', null)
      .single();
    if (findErr || !existing) {
      return res.status(404).json({ success: false, message: 'Catégorie non trouvée' });
    }

    const cleanUpdates = {};
    for (const key of ALLOWED_FIELDS) {
      if (updates[key] !== undefined) cleanUpdates[key] = updates[key];
    }

    if (cleanUpdates.slug && cleanUpdates.slug !== existing.slug) {
      const { data: slugConflict } = await supabaseAdmin
        .from('categories')
        .select('id')
        .eq('slug', cleanUpdates.slug)
        .neq('id', id)
        .is('deleted_at', null);
      if (slugConflict && slugConflict.length > 0) {
        return res.status(409).json({ success: false, message: 'Ce slug est déjà utilisé' });
      }
    }

    if (cleanUpdates.parent_id) {
      if (cleanUpdates.parent_id === id) {
        return res.status(400).json({ success: false, message: 'Une catégorie ne peut pas être son propre parent' });
      }
      const { data: parent } = await supabaseAdmin
        .from('categories')
        .select('id')
        .eq('id', cleanUpdates.parent_id)
        .is('deleted_at', null)
        .single();
      if (!parent) {
        return res.status(400).json({ success: false, message: 'Catégorie parente introuvable' });
      }
    }

    cleanUpdates.updated_at = new Date().toISOString();

    const { data, error } = await supabaseAdmin
      .from('categories')
      .update(cleanUpdates)
      .eq('id', id)
      .select()
      .single();

    if (error) throw error;

    // Supprime l'ancienne image du Storage si elle a été remplacée
    if (updates.image_url !== undefined && existing.image_url && existing.image_url !== cleanUpdates.image_url) {
      try {
        const oldPath = new URL(existing.image_url).pathname.replace(/^\//, '');
        await removeFile(oldPath, 'categories');
      } catch (_) { /* non bloquant */ }
    }

    return res.json({ success: true, message: 'Catégorie mise à jour', data });
  } catch (error) {
    return res.status(500).json({ success: false, message: error.message });
  }
};

// --------------------------------------------------------------------
// DELETE /api/categories/:id (soft delete + vérifications)
// --------------------------------------------------------------------
exports.deleteCategory = async (req, res) => {
  try {
    const { id } = req.params;

    const { data: children } = await supabaseAdmin
      .from('categories')
      .select('id')
      .eq('parent_id', id)
      .is('deleted_at', null);
    if (children && children.length > 0) {
      return res.status(400).json({
        success: false,
        message: "Impossible de supprimer : des sous-catégories existent. Supprimez-les d'abord.",
      });
    }

    const { data: products } = await supabaseAdmin
      .from('products')
      .select('id')
      .eq('category_id', id)
      .is('deleted_at', null)
      .limit(1);
    if (products && products.length > 0) {
      return res.status(400).json({
        success: false,
        message: "Impossible de supprimer : des produits sont rattachés à cette catégorie. Réaffectez-les d'abord.",
      });
    }

    const { data, error } = await supabaseAdmin
      .from('categories')
      .update({ deleted_at: new Date().toISOString() })
      .eq('id', id)
      .select()
      .single();
    if (error) throw error;

    return res.json({ success: true, message: 'Catégorie supprimée (corbeille)', data });
  } catch (error) {
    return res.status(500).json({ success: false, message: error.message });
  }
};